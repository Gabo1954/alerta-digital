# --- SYSTEM FILES ---
.DS_Store
Thumbs.db
*.log
*.msi
*.exe
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- DEPENDENCIES ---
# Ignora las carpetas pesadas de librerías
node_modules/
backend/node_modules/
frontend/node_modules/

# --- CONFIG & SECRETS ---
# ¡CRÍTICO! Nunca subir credenciales ni claves
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- ORACLE CLOUD (BACKEND) ---
# NOTA: La carpeta de la Wallet NO se ignora para que Render pueda acceder a ella.
# Solo ignoramos los archivos comprimidos originales (.zip) que descargas de Oracle.
*.zip

# --- FRONTEND BUILDS (React/Vite) ---
# Ignora las carpetas de producción generadas
frontend/dist/
frontend/build/
dist/
build/

# --- ANDROID / CAPACITOR ---
# Ignora los archivos compilados pesados y cachés de Android Studio
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
*.apk
*.aab
*.keystore

